# Copy to .env.local and fill in. NEVER commit real values.
# Private keys stay in ~/.arc-canteen/wallet.yaml or the Circle CLI, not here.

# Arc testnet RPC from `arc-canteen rpc-url` (contains a key, keep private)
ARC_RPC_URL=
ARC_CHAIN_ID=5042002

# LLM provider key for the agent
ANTHROPIC_API_KEY=

# Payment mode: local | testnet | mainnet  (default local; UI labels evidence by mode)
PAYMENT_MODE=local

# Circle developer-controlled wallets (testnet). Run `node scripts/circle-setup.mjs` once.
# API key: console.circle.com -> Keys (must start with TEST_API_KEY:)
CIRCLE_API_KEY=
# Filled in by scripts/circle-setup.mjs. Recovery file goes to ~/.kesuni3d/, never the repo.
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_BLOCKCHAIN=ARC-TESTNET
# Public address that receives released escrow (Kesuni's Arc testnet wallet)
KESUNI_PAYOUT_ADDRESS=0xE4E4ce87fb23C3F56D09af887b6eD0Ec4978E302
# Testnet only: Circle SCA wallet in the wallet set that tops up customer wallets with test USDC
KESUNI_DEMO_FUNDS_ADDRESS=

# Bambu A1 LAN bridge (scripts/printer-bridge.mjs). Token is shared by the app and the bridge.
PRINTER_BRIDGE_TOKEN=
# Printer screen: Settings -> WLAN (IP) / Device (serial) / LAN access code. Keep the access code private.
PRINTER_IP=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=
# Where the bridge sends reports (local dev or the live app URL)
# More printers: PRINTER_2_IP / PRINTER_2_SERIAL / PRINTER_2_ACCESS_CODE, then _3 ...
APP_URL=http://localhost:3000

# Public link (Cloudflare tunnel): operator pages need this password from outside the home network.
# Customer pages (/c/<token>) and the order form (/pesan/<code>) stay open.
OPERATOR_PASSWORD=
# Customer order form lives at /pesan/<this code>. Share the link only with customers.
CUSTOMER_INVITE_CODE=
# Rupiah per USDC, for showing prices to customers (display only)
IDR_PER_USDC=16500

# ---------- The Chief Kesuni Officer (AI agent) ----------
# claude | rules. Default: claude when ANTHROPIC_API_KEY is set, else the rule-based planner.
KESUNI_AGENT_MODE=
# Model when no Test/Demo profile is saved on the home page. Default claude-sonnet-5-5 (Demo profile = claude-opus-5-5).
KESUNI_AGENT_MODEL=
# Heartbeat: seconds between the Chief's rounds (code checks first; Claude only for new problems). Default 120, 0 = off, minimum 10.
KESUNI_HEARTBEAT_SECONDS=120
# Daily review for the owner: Jakarta hour (0-23) after which the heartbeat writes it once a day. Default 21; "off" = only by button.
KESUNI_DAILY_REVIEW_HOUR=21

# ---------- Pricing by weight (rupiah) ----------
# Selling price per gram; unit price is rounded UP to KESUNI_PRICE_ROUND_IDR. Default 1500.
KESUNI_PRICE_PER_GRAM_IDR=1500
# Kesuni's cost per gram (filament, finishing, print hours, electricity). Default 750.
KESUNI_COST_PER_GRAM_IDR=750
# Round each unit price up to this many rupiah. Default 500.
KESUNI_PRICE_ROUND_IDR=500
# Rough print speed of one A1 with PLA, for the ETA. Default 15 g/hour.
KESUNI_GRAMS_PER_HOUR=15
# Printers sharing the work, for the ETA. Default 2.
KESUNI_PRINTER_COUNT=2

# ---------- The owner's rules (enforced in code) ----------
# Orders under this need the owner's approval. Default 100000.
KESUNI_MIN_ORDER_IDR=100000
# Orders above this need the owner's approval. Default 1000000.
KESUNI_OWNER_APPROVAL_ABOVE_IDR=1000000
# Partners only get orders of at least this value. Default 300000.
KESUNI_PARTNER_MIN_IDR=300000
# Lowest margin (%) the Chief may price at on its own. Default 15.
KESUNI_MIN_MARGIN_PCT=15
# What Kesuni keeps (%) when a partner prints. Default 20.
KESUNI_PARTNER_MARGIN_PCT=20

# ---------- Network (Arc Testnet now; mainnet later is configuration, see docs/PILOT.md) ----------
# Mainnet moves real USDC: set to 1 only after the owner approves and the PILOT.md checks are done. Default: locked.
KESUNI_ALLOW_MAINNET=
# Explorer link for transactions on CIRCLE_BLOCKCHAIN (tx hash is appended). Default: the Arc Testnet explorer.
KESUNI_EXPLORER_TX_URL=
# USDC token address shown for the network. Default: Arc Testnet USDC 0x3600000000000000000000000000000000000000.
KESUNI_USDC_ADDRESS=

# ---------- Local storage ----------
# SQLite file. Default data/local/kesuni.db (git-ignored).
KESUNI_DB_PATH=
# Uploaded files (designs, QC photos). Default data/local/files (git-ignored).
KESUNI_FILES_DIR=
