# Copy to .env.local and fill in. NEVER commit real values.
# Private keys stay in ~/.arc-canteen/wallet.yaml or the Circle CLI, not here.

# Claude API key for the Chief (the AI agent). Empty = the rule-based planner runs instead (free; the same tools and policy).
ANTHROPIC_API_KEY=

# Circle developer-controlled wallets (testnet). Run `node scripts/circle-setup.mjs` once.
# API key: console.circle.com -> Keys (must start with TEST_API_KEY:)
CIRCLE_API_KEY=
# Filled in by scripts/circle-setup.mjs. Recovery file goes to ~/.kesuni3d/, never the repo.
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_BLOCKCHAIN=ARC-TESTNET
# Public address that receives released escrow (Kesuni's Arc testnet wallet)
KESUNI_PAYOUT_ADDRESS=0xE4E4ce87fb23C3F56D09af887b6eD0Ec4978E302
# Testnet only: Circle SCA wallet in the wallet set that tops up customer wallets with test USDC
KESUNI_DEMO_FUNDS_ADDRESS=

# Bambu A1 LAN bridge (scripts/printer-bridge.mjs). Token is shared by the app and the bridge.
PRINTER_BRIDGE_TOKEN=
# Printer screen: Settings -> WLAN (IP) / Device (serial) / LAN access code. Keep the access code private.
PRINTER_IP=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=
# Where the bridge sends reports (local dev or the live app URL), comma separated. Plain http only for this computer
# or the studio network (the bridge token must not travel in clear text): use https for Railway.
# More printers: PRINTER_2_IP / PRINTER_2_SERIAL / PRINTER_2_ACCESS_CODE, then _3 ...
APP_URL=http://localhost:3000
# Printer controls and print jobs come from ONE app. Default: the first APP_URL on this computer or the studio
# network. A public app (Railway) controls the printers only when it is named here:
# CONTROL_APP_URL=https://<your-app>.up.railway.app
# Status only, no commands at all (same as: node scripts/printer-bridge.mjs --read-only):
# BRIDGE_CONTROL=off
# Test without touching the printers: node scripts/printer-bridge.mjs --dry-run (prints what it would send)
# Slicing on the website: the bridge slices STL/OBJ with this PC's Bambu Studio (02.08) for the control app.
# Empty = C:\Program Files\Bambu Studio\bambu-studio.exe and its resources\profiles\BBL. BRIDGE_SLICER=off takes no slices.
BAMBU_STUDIO_PATH=
BAMBU_PROFILES_DIR=
# BRIDGE_SLICER=off

# Public link (Railway or a Cloudflare tunnel): operator pages need this password from outside the home network.
# Customer pages (/c/<token>, /customer, /request/<code>) and the public pages (/, /live) stay open.
OPERATOR_PASSWORD=
# Customer portal: /customer shows the order form at /request/<this code>. Empty = the portal is closed (404).
CUSTOMER_INVITE_CODE=
# Studio WhatsApp for the customers' "Chat Kesuni" button: digits with country code, e.g. 62812…. Empty = no button.
KESUNI_WHATSAPP=
# Rupiah per USDC, for showing prices to customers (display only)
IDR_PER_USDC=16500
# Demo video on the landing page: a YouTube or Vimeo link, or an https .mp4. Empty = no video and no "Watch the demo" button.
DEMO_VIDEO_URL=

# ---------- The Chief Kesuni Officer (AI agent) ----------
# claude | rules. Default: claude when ANTHROPIC_API_KEY is set, else the rule-based planner.
KESUNI_AGENT_MODE=
# Model when no Test/Demo profile is saved on the home page. Default claude-sonnet-5-5 (Demo profile = claude-opus-5-5).
KESUNI_AGENT_MODEL=
# Heartbeat: seconds between the Chief's rounds (code checks first; Claude only for new problems). Default 120, 0 = off, minimum 10.
KESUNI_HEARTBEAT_SECONDS=120
# Daily review for the owner: Jakarta hour (0-23) after which the heartbeat writes it once a day. Default 21; "off" = only by button.
KESUNI_DAILY_REVIEW_HOUR=21
# Background Chief wake-ups per hour, all orders together (new order, payment, owner approval). Default 20.
KESUNI_MAX_WAKES_PER_HOUR=

# ---------- Pricing by weight (rupiah) ----------
# Selling price per gram; unit price is rounded UP to KESUNI_PRICE_ROUND_IDR. Default 1500.
KESUNI_PRICE_PER_GRAM_IDR=1500
# Kesuni's cost per gram (filament, finishing, print hours, electricity). Default 750.
KESUNI_COST_PER_GRAM_IDR=750
# PETG price and cost per gram. Leave empty to use the PLA numbers above (owner, 15 Oct 2026: PETG priced like PLA).
KESUNI_PRICE_PER_GRAM_IDR_PETG=
KESUNI_COST_PER_GRAM_IDR_PETG=
# Round each unit price up to this many rupiah. Default 500.
KESUNI_PRICE_ROUND_IDR=500
# Print minutes per gram on one A1 Combo, as "min-max". Default 3-5 in one colour, 5-15 in multi colour (AMS).
KESUNI_PRINT_MIN_PER_GRAM_SINGLE=3-5
KESUNI_PRINT_MIN_PER_GRAM_MULTI=5-15
# Hours to collect, check and pack after printing (added to the print time for "ready in"). Default 1.
KESUNI_HANDLING_HOURS=1
# Printers that print units side by side (the studio has three A1 Combo). Default 3.
KESUNI_PRINTER_COUNT=3

# ---------- The owner's rules (enforced in code) ----------
# Orders under this need the owner's approval. Default 100000.
KESUNI_MIN_ORDER_IDR=100000
# Orders above this need the owner's approval. Default 1000000.
KESUNI_OWNER_APPROVAL_ABOVE_IDR=1000000
# Partners only get orders of at least this value. Default 300000.
KESUNI_PARTNER_MIN_IDR=300000
# Lowest margin (%) the Chief may price at on its own. Default 15.
KESUNI_MIN_MARGIN_PCT=15
# What Kesuni keeps (%) when a partner prints. Default 20.
KESUNI_PARTNER_MARGIN_PCT=20

# ---------- Network (Arc Testnet now; mainnet later is configuration, see docs/PILOT.md) ----------
# Mainnet moves real USDC: set to 1 only after the owner approves and the PILOT.md checks are done. Default: locked.
KESUNI_ALLOW_MAINNET=
# Explorer link for transactions on CIRCLE_BLOCKCHAIN (tx hash is appended). Default: the Arc Testnet explorer.
KESUNI_EXPLORER_TX_URL=
# USDC token address shown for the network. Default: Arc Testnet USDC 0x3600000000000000000000000000000000000000.
KESUNI_USDC_ADDRESS=
# Arc RPC for the read-only receipt check (every escrow transfer re-checked on Arc). May contain a key: keep private.
# Default: the public Arc Testnet RPC and chain id 5042002. On mainnet both must be set.
KESUNI_ARC_RPC_URL=
KESUNI_ARC_CHAIN_ID=

# ---------- Local storage ----------
# SQLite file. Default data/local/kesuni.db (git-ignored).
KESUNI_DB_PATH=
# Uploaded files (designs, QC photos). Default data/local/files (git-ignored).
KESUNI_FILES_DIR=

# Agent prints (Chief page switch "Agent may start prints"): off = the agent never starts or slices a print, whatever the switch says.
KESUNI_AUTO_PRINT=
# Printer bridge on the studio PC: on = also carry out agent prints (queued by the app only after a person's "Bed is empty"). Empty = refused.
BRIDGE_AGENT_PRINTS=
